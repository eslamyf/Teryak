# ===================================================
# 🌿 مشروع منصة ترياق الطبية (Teryak Platform) - .gitignore
# ===================================================

# 1. ملفات البيئة والأسرار الحساسة (Environment & Secrets)
# ---------------------------------------------------
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env
*.env.*
# استثناء ملف المثال فقط لمشاركته مع الفريق
!.env.example
!backend/.env.example
*.pem
*.key
*.cert
*.crt

# 2. الحزم والمكتبات (Dependencies)
# ---------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js

# 3. ملفات السجلات وتصحيح الأخطاء (Logs & Debugging)
# ---------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. مخرجات البناء والإنتاج (Build & Production Artifacts)
# ---------------------------------------------------
dist/
build/
out/
.next/
.nuxt/
.vercel
.turbo/
.cache/
.parcel-cache/
.serverless/

# 5. ملفات الاختبار والتغطية (Testing & Coverage)
# ---------------------------------------------------
coverage/
*.lcov
.nyc_output/

# 6. المرفقات والملفات المؤقتة للمستخدم (Uploads & Temp)
# ---------------------------------------------------
uploads/
backend/uploads/
frontend/uploads/
temp/
tmp/
*.tmp
*.temp

# 7. إعدادات بيئات التطوير والمحررات (IDEs & Editors)
# ---------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# 8. ملفات أنظمة التشغيل (OS Generated Files)
# ---------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
