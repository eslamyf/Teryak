# ====================================================================
# خادم وتطبيق ترياق (Server & Application Configuration)
# ====================================================================
NODE_ENV=development
PORT=5000

# ====================================================================
# قاعدة البيانات (MongoDB Connection URI)
# ====================================================================
MONGODB_URI=mongodb://127.0.0.1:27017/teryak_db
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/teryak_db?retryWrites=true&w=majority

# ====================================================================
# التوثيق والأمان (JSON Web Token Secrets)
# ====================================================================
JWT_SECRET=teryak_secret_jwt_key_2026_super_secure_hash_89a4b98c76ef4
JWT_EXPIRES_IN=7d

# ====================================================================
# سياسات مشاركة الموارد (CORS Settings)
# ====================================================================
CLIENT_URL=http://localhost:5000,http://127.0.0.1:5500,http://localhost:3000

# ====================================================================
# خدمة رفع الصور والملفات (اختياري - Cloudinary)
# ====================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
